# camera_module pip extra: zivid
# Path: configs/modules/camera_module/extras/zivid.env

EXTRA_NAME=zivid
HOST_INSTALL_ZIVID_SDK=1
DOCKER_BUILD_ZIVID=1
VERIFY_IMPORTS_EXTRA="zivid"

# Used by examples/capture/ (optional smoke test)
CAPTURE_ENABLED=1
CAPTURE_GPU=1
CAPTURE_WORKDIR=scripts/python_run
CAPTURE_CAMERA_TYPE=zivid
CAPTURE_DEVICE_ID=FileCameraZivid2PlusMR130.zfc
CAPTURE_VIRTUAL_DATA=src/crp_camera/cam/zivid/data
CAPTURE_CONFIG=configs/zivid.config.yml
CAPTURE_PROJECT=ZividCapture
CAPTURE_NODE=zivid_camera
