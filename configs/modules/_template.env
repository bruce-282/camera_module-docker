# Copy to configs/modules/<your_module>.env
#
# pip extras (optional): configs/modules/<your_module>/extras/<name>.env
#   — only if the module has pyproject optional-dependencies (see camera_module/)
#
# Usage:
#   make install-host MODULE=<your_module>

MODULE_NAME=your_module
MODULE_DIR_DEFAULT="${HOME}/your_module"
MODULE_REPO=gitlab.cmes-ai.com/group/your_module.git
MODULE_BRANCH=main
MODULE_PIP_EXTRA_DEFAULT=

PASS_CLONE=gitlab/cmesrobotics/your_module
PASS_PIP=gitlab/cmesrobotics/crp_core

VERIFY_IMPORTS="your_package"

DOCKER_IMAGE=cmes/your-module:dev
DOCKER_GPU_RUN=0

# Optional hint when no capture test is configured
MODULE_RUN_HINT="See module README for how to run"
