# calibration_module — hand-eye / calibration (no pip extra)

MODULE_NAME=calibration_module
MODULE_DIR_DEFAULT="${HOME}/calibration_module"
MODULE_REPO=gitlab.cmes-ai.com/crp/module/calibration_module.git
MODULE_BRANCH=dev/0.x
MODULE_PIP_EXTRA_DEFAULT=

PASS_CLONE=gitlab/cmesrobotics/calibration_module
PASS_PIP=gitlab/cmesrobotics/crp_core

VERIFY_IMPORTS="crp_calibration crp_core"

DOCKER_IMAGE=cmes/calibration-module:dev
DOCKER_GPU_RUN=0

MODULE_RUN_HINT="source .venv/bin/activate — see module README"
