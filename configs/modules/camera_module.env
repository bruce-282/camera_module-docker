# camera_module — CRP camera module
# pip extras: configs/modules/camera_module/extras/{zivid,orbbec-linux,none}.env

MODULE_NAME=camera_module
MODULE_DIR_DEFAULT="${HOME}/camera_module"
MODULE_REPO=gitlab.cmes-ai.com/crp/module/camera_module.git
MODULE_BRANCH=dev/0.x
MODULE_PIP_EXTRA_DEFAULT=zivid

PASS_CLONE=gitlab/cmesrobotics/camera_module
PASS_PIP=gitlab/cmesrobotics/crp_core

VERIFY_IMPORTS="crp_camera crp_core"

DOCKER_IMAGE=cmes/crp-module-install:dev
DOCKER_GPU_RUN=1
