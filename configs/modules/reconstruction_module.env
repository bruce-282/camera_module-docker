# reconstruction_module — 3D reconstruction (no pip extra)

MODULE_NAME=reconstruction_module
MODULE_DIR_DEFAULT="${HOME}/reconstruction_module"
MODULE_REPO=gitlab.cmes-ai.com/crp/module/reconstruction_module.git
MODULE_BRANCH=dev/0.x
MODULE_PIP_EXTRA_DEFAULT=

PASS_CLONE=gitlab/cmesrobotics/reconstruction_module
PASS_PIP=gitlab/cmesrobotics/crp_core

VERIFY_IMPORTS="crp_reconstruction crp_core"

DOCKER_IMAGE=cmes/reconstruction-module:dev
DOCKER_GPU_RUN=0

MODULE_RUN_HINT="source .venv/bin/activate — see module README"
